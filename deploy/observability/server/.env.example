# Observability server deployment — non-secret overrides.
# Copy to .env in this directory if you need to change paths (the defaults
# below are used when unset). Real secrets are NOT kept in .env: they live in
# /opt/amocrm-observability/secrets/* and are bind-mounted into containers.

# Base directory for persistent component data (bind mounts).
OBSERVABILITY_DATA_DIR=/opt/amocrm-observability/data

# Directory holding the secret files (see README for the full list).
OBSERVABILITY_SECRETS_DIR=/opt/amocrm-observability/secrets
