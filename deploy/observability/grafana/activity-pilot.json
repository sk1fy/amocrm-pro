      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "activity_delivery_errors", "legendFormat": "outbox {{code}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(amocrm_requests_total{outcome=\"401\"}[5m]))", "legendFormat": "v4 401/s", "refId": "B" }
      ],
      "title": "Reauth and delivery errors",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
