      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (le, method) (rate(service_rpc_duration_seconds_bucket{method=~\"/amocrm.services.v1.Activity/GetPanel|/amocrm.services.v1.Activity/GetEvent|/amocrm.services.v1.CRMEvents/QueryEvents|/amocrm.services.v1.CRMEvents/GetEvent\"}[5m])))", "legendFormat": "rpc p95 {{method}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(amocrm_budget_wait_seconds_bucket[5m])))", "legendFormat": "budget wait p95 {{outcome}}", "refId": "B" }
      ],
      "title": "Read P95 and budget wait",
      "type": "timeseries"
    },
