      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "crm_events_jobs", "legendFormat": "events {{state}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "activity_delivery_commands", "legendFormat": "outbox {{state}}", "refId": "B" },
