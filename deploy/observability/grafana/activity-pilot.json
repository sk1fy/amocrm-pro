        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum by (le, route) (rate(activity_http_response_bytes_bucket[5m])))", "legendFormat": "p99 {{route}}", "refId": "B" }
