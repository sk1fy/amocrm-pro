# Copy outside the repository, chmod 600, populate with operator-owned values.
# Use full sha256 image IDs or repository@sha256:digest, never mutable tags.
PLATFORM_IMAGE=
PLATFORM_MIGRATOR_IMAGE=
PLATFORM_LIFECYCLE_IMAGE=
PLATFORM_OWNER_DATABASE_URL=
PLATFORM_ACCESS_DATABASE_URL=
PLATFORM_JOBS_DATABASE_URL=
# Remote PostgreSQL DSNs require sslmode=verify-full and trusted CA configuration.
PLATFORM_TLS_DIR=
PLATFORM_MANIFEST_DIR=
PLATFORM_MANAGER_CURSOR_KEY=
PLATFORM_MANAGER_TIME_ZONE=Europe/Moscow
PLATFORM_WORKERS=2
PLATFORM_ACCESS_POOL_MAX_CONNS=4
PLATFORM_JOBS_POOL_MAX_CONNS=4
PLATFORM_PUBLIC_BIND=127.0.0.1
PLATFORM_PRIVATE_BIND=127.0.0.1
PLATFORM_PUBLIC_PORT=18080
PLATFORM_PRIVATE_PORT=18443
PLATFORM_ACCESS_PROOF_PUBLIC_KEYS=
PLATFORM_ACCESS_PILOT_ORIGIN=
PLATFORM_ACCOUNT_GATEWAY_ADDRESS=
PLATFORM_ACCOUNT_GATEWAY_SERVER_NAME=
# Optional separate identity directory; defaults to PLATFORM_TLS_DIR.
PLATFORM_GATEWAY_IDENTITY_DIR=
