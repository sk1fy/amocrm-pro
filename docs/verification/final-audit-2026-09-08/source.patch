+func TestEnumCardKeepsLabelsBeyondDetailBlockLimit(t *testing.T) {
+	entries := make([]string, 40)
+	field := serviceapi.CustomField{ID: 10, EntityType: "leads", Name: "Варианты"}
+	for i := range entries {
+		id := int64(i + 1)
