+			if o.ObjectKind == "note" {
+				notes++
+				if o.ObjectKey != "202" {
+					t.Fatalf("stale task note %+v", o)
+				}
+			}
+		}
+		if notes != 1 {
+			t.Fatalf("notes=%d", notes)
