+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {observationLabel,parseDateTimeLocal} from '../vendor/activity-v0/panel.mjs';
+test('vendored adapter preserves observed counts and rejects DST gaps',()=>{
+ assert.match(observationLabel({unique_events:7},'unknown'),/^7 зарегистрировано/);
+ assert.throws(()=>parseDateTimeLocal('2026-03-29T02:30:00','Europe/Oslo'));
+ assert.equal(parseDateTimeLocal('2026-10-25T02:30:00','Europe/Oslo'),Date.parse('2026-10-25T00:30:00Z')/1000);
+});
